# ---- Runtime mode ----
# production: only real device data accepted; simulator payloads rejected
# demo: real + simulated (simulated always tagged source=simulated)
APP_MODE=demo

# ---- Database (Tiger Data in prod; local timescaledb container in dev) ----
DATABASE_URL=postgresql://halo:halo@timescaledb:5432/halo

# ---- RabbitMQ ----
RABBITMQ_URL=amqp://halo:halo@rabbitmq:5672/
RABBITMQ_USER=halo
RABBITMQ_PASS=halo
MQTT_HOST=localhost
MQTT_PORT=1883

# ---- Auth ----
REVIEWER_API_KEY=change-me
DEVICE_SHARED_SECRET=change-me

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Solana (Devnet only) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_KEYPAIR_PATH=/secrets/treasury.json
SOLANA_USDC_MINT=
BOUNTY_AMOUNT=5

# ---- Storage (Vultr Object Storage, S3-compatible; optional) ----
S3_ENDPOINT=
S3_BUCKET=hydrant-halo
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
